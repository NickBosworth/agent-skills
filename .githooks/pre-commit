#!/bin/sh
set -eu
publication_python=python3
if [ -x .venv/bin/python ]; then publication_python=.venv/bin/python; fi
"$publication_python" -c 'import yaml' >/dev/null 2>&1 || { echo 'Install requirements-dev.txt in .venv before committing.' >&2; exit 1; }
"$publication_python" tools/check_library.py --staged
command -v gitleaks >/dev/null 2>&1 || { echo 'Gitleaks is required for the publication hook.' >&2; exit 1; }
git diff --cached --binary | gitleaks stdin --redact --no-banner
